{
  "$defs": {
    "CalibrationClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "CalibrationClaim",
      "type": "object"
    },
    "ContactRouteStatus": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "source_supported_route",
            "not_established",
            "human_confirmation_needed"
          ],
          "title": "Status",
          "type": "string"
        },
        "route_kind": {
          "default": "unknown",
          "enum": [
            "company_route",
            "person_route",
            "operator_record",
            "unknown"
          ],
          "title": "Route Kind",
          "type": "string"
        },
        "route_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Ref"
        },
        "person_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Person Id"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "ContactRouteStatus",
      "type": "object"
    },
    "IntroBlocker": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "identity",
            "scope",
            "current_operator_or_status",
            "missing_concrete_rationale"
          ],
          "title": "Kind",
          "type": "string"
        },
        "what_to_resolve": {
          "minLength": 1,
          "title": "What To Resolve",
          "type": "string"
        },
        "decision_consequence": {
          "minLength": 1,
          "title": "Decision Consequence",
          "type": "string"
        }
      },
      "required": [
        "text",
        "kind",
        "what_to_resolve",
        "decision_consequence"
      ],
      "title": "IntroBlocker",
      "type": "object"
    },
    "IntroCondition": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "supported",
            "unresolved",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "text",
        "status"
      ],
      "title": "IntroCondition",
      "type": "object"
    },
    "IntroContraryFact": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "effect": {
          "enum": [
            "limits_claim",
            "prevents_honest_intro",
            "confirmed_outside_scope"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "text",
        "effect"
      ],
      "title": "IntroContraryFact",
      "type": "object"
    },
    "IntroMinimum": {
      "additionalProperties": false,
      "properties": {
        "identity_and_scope": {
          "$ref": "#/$defs/IntroCondition"
        },
        "concrete_product_program_or_problem": {
          "$ref": "#/$defs/IntroCondition"
        },
        "useful_conversation_reason": {
          "$ref": "#/$defs/IntroCondition"
        }
      },
      "required": [
        "identity_and_scope",
        "concrete_product_program_or_problem",
        "useful_conversation_reason"
      ],
      "title": "IntroMinimum",
      "type": "object"
    },
    "RelevantPersonStatus": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "source_attributed_current",
            "historical_or_uncertain",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "person_ids": {
          "items": {
            "type": "string"
          },
          "title": "Person Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "RelevantPersonStatus",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "minimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "thesis_version": {
          "minimum": 1,
          "title": "Thesis Version",
          "type": "integer"
        },
        "policy_version": {
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "thesis_version",
        "policy_version",
        "evidence_hash"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_path": {
      "minLength": 1,
      "title": "Source Path",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "entry_id": {
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "assessment_ref": {
      "minLength": 1,
      "title": "Assessment Ref",
      "type": "string"
    },
    "author": {
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "suggested_category": {
      "enum": [
        "outreach_candidate",
        "research_first",
        "monitor",
        "outside_scope"
      ],
      "title": "Suggested Category",
      "type": "string"
    },
    "rationale": {
      "$ref": "#/$defs/CalibrationClaim"
    },
    "minimum": {
      "$ref": "#/$defs/IntroMinimum"
    },
    "contrary_facts": {
      "items": {
        "$ref": "#/$defs/IntroContraryFact"
      },
      "title": "Contrary Facts",
      "type": "array"
    },
    "call_questions": {
      "items": {
        "$ref": "#/$defs/CalibrationClaim"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Call Questions",
      "type": "array"
    },
    "pre_intro_blocker": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntroBlocker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "future_merit_trigger": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibrationClaim"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "relevant_person": {
      "$ref": "#/$defs/RelevantPersonStatus"
    },
    "contact_route": {
      "$ref": "#/$defs/ContactRouteStatus"
    }
  },
  "required": [
    "source_path",
    "source_sha256",
    "version",
    "entry_id",
    "input_ref",
    "assessment_ref",
    "author",
    "suggested_category",
    "rationale",
    "minimum",
    "call_questions",
    "relevant_person",
    "contact_route"
  ],
  "title": "PreOutreachGuidance",
  "type": "object"
}
