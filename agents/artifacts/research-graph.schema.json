    "ResearchDecision": {
      "additionalProperties": false,
      "properties": {
        "assessment_ref": {
          "title": "Assessment Ref",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "decision": {
          "enum": [
            "pursue",
            "monitor"
          ],
          "title": "Decision",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "decision_consequence": {
          "minLength": 1,
          "title": "Decision Consequence",
          "type": "string"
        },
        "future_trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Future Trigger"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "assertion_kind": {
          "const": "inferred",
          "default": "inferred",
          "title": "Assertion Kind",
          "type": "string"
        },
        "qualification_note": {
          "const": "Research next-action recommendation only; human qualification approval remains separate",
          "default": "Research next-action recommendation only; human qualification approval remains separate",
          "title": "Qualification Note",
          "type": "string"
        }
