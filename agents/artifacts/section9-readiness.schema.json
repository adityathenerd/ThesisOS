{
  "$defs": {
    "FounderReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "person_ids": {
          "items": {
            "type": "string"
          },
          "title": "Person Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "FounderReviewCheck",
      "type": "object"
    },
    "HumanContradictionAcceptance": {
      "additionalProperties": false,
      "description": "Backend-supplied durable reviewer action; never generated by the agent.",
      "properties": {
        "review_record_id": {
          "minLength": 1,
          "title": "Review Record Id",
          "type": "string"
        },
        "assessment_ref": {
          "title": "Assessment Ref",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "contradiction_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradiction Ids",
          "type": "array"
        },
        "current": {
          "title": "Current",
          "type": "boolean"
        }
      },
      "required": [
        "review_record_id",
        "assessment_ref",
        "input_ref",
        "contradiction_ids",
        "current"
      ],
      "title": "HumanContradictionAcceptance",
      "type": "object"
    },
    "MaterialContradiction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "explanation",
        "evidence_ids",
        "resolved"
      ],
      "title": "MaterialContradiction",
      "type": "object"
    },
    "ProductReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "inspected_documentation",
            "inspected_prototype",
            "inspected_experiment",
            "hands_on_workflow",
            "source_claim_only",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation",
        "basis"
      ],
      "title": "ProductReviewCheck",
      "type": "object"
    },
    "ReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "ReviewCheck",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "minimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "thesis_version": {
          "minimum": 1,
          "title": "Thesis Version",
          "type": "integer"
        },
        "policy_version": {
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "thesis_version",
        "policy_version",
        "evidence_hash"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_ref": {
      "title": "Assessment Ref",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "primary_track": {
      "enum": [
        "H",
        "R",
        "D",
        "T"
      ],
      "title": "Primary Track",
      "type": "string"
    },
    "identity_and_scope": {
      "$ref": "#/$defs/ReviewCheck"
    },
    "problem_or_program": {
      "$ref": "#/$defs/ReviewCheck"
    },
    "founder_contribution": {
      "$ref": "#/$defs/FounderReviewCheck"
    },
    "differentiated_approach": {
      "$ref": "#/$defs/ReviewCheck"
    },
    "product_or_experimental_gate": {
      "$ref": "#/$defs/ProductReviewCheck"
    },
    "material_contradictions": {
      "items": {
        "$ref": "#/$defs/MaterialContradiction"
      },
      "title": "Material Contradictions",
      "type": "array"
    },
    "human_contradiction_acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanContradictionAcceptance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "remaining_risks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Remaining Risks",
      "type": "array"
    }
  },
  "required": [
    "assessment_ref",
    "input_ref",
    "primary_track",
    "identity_and_scope",
    "problem_or_program",
    "founder_contribution",
    "differentiated_approach",
    "product_or_experimental_gate",
    "remaining_risks"
  ],
  "title": "Section9Readiness",
  "type": "object"
}
