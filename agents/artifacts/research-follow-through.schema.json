{
  "$defs": {
    "BoundaryConclusion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "supported_outside_scope",
            "decline"
          ],
          "title": "Kind",
          "type": "string"
        },
        "basis": {
          "enum": [
            "confirmed_sector_mismatch",
            "no_repeatable_core_after_investigation",
            "approved_boundary_failure",
            "human_pass"
          ],
          "title": "Basis",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "criterion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion Id"
        },
        "human_pass_record_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Pass Record Ref"
        }
      },
      "required": [
        "kind",
        "basis",
        "rationale",
        "evidence_ids"
      ],
      "title": "BoundaryConclusion",
      "type": "object"
    },
    "FounderReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "person_ids": {
          "items": {
            "type": "string"
          },
          "title": "Person Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "FounderReviewCheck",
      "type": "object"
    },
    "HumanContradictionAcceptance": {
      "additionalProperties": false,
      "description": "Backend-supplied durable reviewer action; never generated by the agent.",
      "properties": {
        "review_record_id": {
          "minLength": 1,
          "title": "Review Record Id",
          "type": "string"
        },
        "assessment_ref": {
          "title": "Assessment Ref",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "contradiction_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contradiction Ids",
          "type": "array"
        },
        "current": {
          "title": "Current",
          "type": "boolean"
        }
      },
      "required": [
        "review_record_id",
        "assessment_ref",
        "input_ref",
        "contradiction_ids",
        "current"
      ],
      "title": "HumanContradictionAcceptance",
      "type": "object"
    },
    "HumanResearchPoint": {
      "additionalProperties": false,
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "what_to_obtain": {
          "title": "What To Obtain",
          "type": "string"
        },
        "decision_consequence": {
          "title": "Decision Consequence",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "why_agent_stopped": {
          "title": "Why Agent Stopped",
          "type": "string"
        },
        "attempted_task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Attempted Task Ids",
          "type": "array"
        }
      },
      "required": [
        "question_id",
        "question",
        "what_to_obtain",
        "decision_consequence",
        "evidence_ids",
        "why_agent_stopped",
        "attempted_task_ids"
      ],
      "title": "HumanResearchPoint",
      "type": "object"
    },
    "Investigation": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "company",
            "person",
            "relationship",
            "market"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "decision_consequence": {
          "minLength": 1,
          "title": "Decision Consequence",
          "type": "string"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "max_calls": {
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        }
      },
      "required": [
        "criterion_id",
        "subject_kind",
        "subject_id",
        "action",
        "question",
        "decision_consequence",
        "query",
        "max_calls"
      ],
      "title": "Investigation",
      "type": "object"
    },
    "MaterialContradiction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "resolved": {
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "explanation",
        "evidence_ids",
        "resolved"
      ],
      "title": "MaterialContradiction",
      "type": "object"
    },
    "ProductReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "inspected_documentation",
            "inspected_prototype",
            "inspected_experiment",
            "hands_on_workflow",
            "source_claim_only",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "status",
        "explanation",
        "basis"
      ],
      "title": "ProductReviewCheck",
      "type": "object"
    },
    "ResearchTaskIntent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "investigate_claim",
          "default": "investigate_claim",
          "title": "Kind",
          "type": "string"
        },
        "assessment_ref": {
          "title": "Assessment Ref",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "investigation": {
          "$ref": "#/$defs/Investigation"
        },
        "acceptance": {
          "const": "backend_reserves_executes_persists_then_reassesses",
          "default": "backend_reserves_executes_persists_then_reassesses",
          "title": "Acceptance",
          "type": "string"
        }
      },
      "required": [
        "assessment_ref",
        "input_ref",
        "question_id",
        "idempotency_key",
        "investigation"
      ],
      "title": "ResearchTaskIntent",
      "type": "object"
    },
    "ReviewCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "mixed",
            "contradicted",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "explanation"
      ],
      "title": "ReviewCheck",
      "type": "object"
    },
    "Section9Readiness": {
      "additionalProperties": false,
      "properties": {
        "assessment_ref": {
          "title": "Assessment Ref",
          "type": "string"
        },
        "input_ref": {
          "$ref": "#/$defs/VersionRef"
        },
        "primary_track": {
          "enum": [
            "H",
            "R",
            "D",
            "T"
          ],
          "title": "Primary Track",
          "type": "string"
        },
        "identity_and_scope": {
          "$ref": "#/$defs/ReviewCheck"
        },
        "problem_or_program": {
          "$ref": "#/$defs/ReviewCheck"
        },
        "founder_contribution": {
          "$ref": "#/$defs/FounderReviewCheck"
        },
        "differentiated_approach": {
          "$ref": "#/$defs/ReviewCheck"
        },
        "product_or_experimental_gate": {
          "$ref": "#/$defs/ProductReviewCheck"
        },
        "material_contradictions": {
          "items": {
            "$ref": "#/$defs/MaterialContradiction"
          },
          "title": "Material Contradictions",
          "type": "array"
        },
        "human_contradiction_acceptance": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanContradictionAcceptance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remaining_risks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Remaining Risks",
          "type": "array"
        }
      },
      "required": [
        "assessment_ref",
        "input_ref",
        "primary_track",
        "identity_and_scope",
        "problem_or_program",
        "founder_contribution",
        "differentiated_approach",
        "product_or_experimental_gate",
        "remaining_risks"
      ],
      "title": "Section9Readiness",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "case_version": {
          "minimum": 0,
          "title": "Case Version",
          "type": "integer"
        },
        "thesis_version": {
          "minimum": 1,
          "title": "Thesis Version",
          "type": "integer"
        },
        "policy_version": {
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "case_version",
        "thesis_version",
        "policy_version",
        "evidence_hash"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "input_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "assessment_input_ref": {
      "$ref": "#/$defs/VersionRef"
    },
    "assessment_ref": {
      "title": "Assessment Ref",
      "type": "string"
    },
    "state": {
      "enum": [
        "research_required",
        "actively_researching",
        "reassessment_required",
        "ready_for_human_review",
        "monitor",
        "human_research_required",
        "supported_outside_scope",
        "decline"
      ],
      "title": "State",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "task_intents": {
      "items": {
        "$ref": "#/$defs/ResearchTaskIntent"
      },
      "title": "Task Intents",
      "type": "array"
    },
    "active_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Active Task Ids",
      "type": "array"
    },
    "human_research_points": {
      "items": {
        "$ref": "#/$defs/HumanResearchPoint"
      },
      "title": "Human Research Points",
      "type": "array"
    },
    "accepted_delta_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Delta Evidence Ids",
      "type": "array"
    },
    "reassessment_required": {
      "default": false,
      "title": "Reassessment Required",
      "type": "boolean"
    },
    "future_trigger": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Future Trigger"
    },
    "review_kind": {
      "anyOf": [
        {
          "enum": [
            "investment_human",
            "specialist_human"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Kind"
    },
    "readiness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Section9Readiness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readiness_gaps": {
      "items": {
        "type": "string"
      },
      "title": "Readiness Gaps",
      "type": "array"
    },
    "boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundaryConclusion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authority": {
      "const": "research_workflow_not_qualification_or_execution",
      "default": "research_workflow_not_qualification_or_execution",
      "title": "Authority",
      "type": "string"
    }
  },
  "required": [
    "input_ref",
    "assessment_input_ref",
    "assessment_ref",
    "state",
    "explanation"
  ],
  "title": "ResearchFollowThrough",
  "type": "object"
}
