# Copy to config/.env. Server-only secrets must never use a VITE_ prefix.
PROVIDER_MODE=fixture
DATABASE_URL=sqlite:///backend/data/thesisos.db
CRUSTDATA_API_KEY=
# Live sourcing selects an existing backend-registered discovery-only approval.
# Raw filters/access-test JSON cannot be used by the production mandate route.
CRUSTDATA_SEARCH_CONFIG=
# Selector shape example: config/discovery-selection.example.json
# config/crustdata-search.example.json remains an access-test transport example only.
MAX_CASES_PER_RUN=10
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# The actual investment thesis is submitted through POST /api/v1/mandates.
# A placeholder reference is not an approved investment thesis.
